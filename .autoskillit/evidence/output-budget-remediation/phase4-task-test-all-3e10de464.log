task: [test-all] mkdir -p temp
TEST_OUTPUT="temp/test-$(date +%Y-%m-%d_%H%M%S).txt"
echo "Running all tests with -n 4"
echo "Output: $TEST_OUTPUT"

if [[ -d ".venv" ]]; then
  .venv/bin/lint-imports
  PYTEST_CMD=".venv/bin/python -m pytest"
else
  lint-imports
  PYTEST_CMD="pytest"
fi

set -o pipefail
set +e
$PYTEST_CMD ${PYTEST_TEST_PATHS:-tests/} -q --tb=short -n 4 --dist worksteal -m "not smoke and not canary" ${PYTEST_IGNORE_PATHS:-} --disable-warnings -o "addopts=" --basetemp=/dev/shm/pytest-tmp-2b32c8cd -o "cache_dir=/dev/shm/pytest-cache-2b32c8cd" 2>&1 | tee "$TEST_OUTPUT"
PYTEST_EXIT=$?
set +o pipefail
set -e

echo ""
echo "Test output saved to: $TEST_OUTPUT"
exit $PYTEST_EXIT

