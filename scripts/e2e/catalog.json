{
  "sandbox_repository": "TalonT-Org/autoskillit-e2e-sandbox",
  "tests": [
    {
      "name": "canary",
      "kind": "canary",
      "peak_sessions": 1,
      "timeout_sec": 300,
      "trigger_paths": [
        "scripts/e2e/*",
        "scripts/docker/*",
        ".github/workflows/e2e.yml"
      ]
    },
    {
      "name": "clean-install",
      "kind": "clean-install",
      "peak_sessions": 0,
      "timeout_sec": 300,
      "trigger_paths": [
        "src/autoskillit/cli/*",
        "src/autoskillit/workspace/*",
        "scripts/docker/*",
        "scripts/e2e/*",
        ".github/workflows/e2e.yml"
      ],
      "expected_failures": [
        {
          "severity": "warning",
          "check": "mcp_server_registered",
          "message": "autoskillit not registered. Run 'autoskillit install' to install as a plugin, or 'autoskillit init' to register in mcpServers.",
          "issue": "https://github.com/TalonT-Org/AutoSkillit/issues/5242"
        },
        {
          "severity": "warning",
          "check": "plugin_cache_exists",
          "message": "Plugin cache directory missing: /home/autoskillit/.claude/plugins/cache/autoskillit-local/autoskillit. Run `autoskillit install` to recreate it.",
          "issue": "https://github.com/TalonT-Org/AutoSkillit/issues/5243"
        },
        {
          "severity": "warning",
          "check": "plugin_cache_integrity",
          "message": "Plugin cache directory is absent, so hook paths could not be verified: /home/autoskillit/.claude/plugins/cache/autoskillit-local/autoskillit. Run `autoskillit install` to rebuild it.",
          "issue": "https://github.com/TalonT-Org/AutoSkillit/issues/5243"
        },
        {
          "severity": "error",
          "check": "installation_record_invalid",
          "message": "Invalid RECORD path '../../../bin/autoskillit' in /home/autoskillit/.local/share/uv/tools/autoskillit/lib/python3.11/site-packages/autoskillit (active distribution: /home/autoskillit/.local/share/uv/tools/autoskillit/lib/python3.11/site-packages/autoskillit; uv tool: /home/autoskillit/.local/share/uv/tools/autoskillit/lib/python3.11/site-packages/autoskillit)",
          "issue": "https://github.com/TalonT-Org/AutoSkillit/issues/5244"
        }
      ]
    },
    {
      "name": "headless-smoke",
      "kind": "recipe",
      "peak_sessions": 2,
      "timeout_sec": 900,
      "trigger_paths": [
        "src/autoskillit/execution/headless/*",
        "src/autoskillit/execution/backends/*",
        "src/autoskillit/cli/fleet/*",
        "src/autoskillit/fleet/dispatch/*",
        "src/autoskillit/server/*",
        "src/autoskillit/hooks/*",
        "scripts/e2e/*",
        ".github/workflows/e2e.yml"
      ],
      "recipe": "sandbox-smoke",
      "recipe_fixture": "sandbox-smoke.yaml",
      "ingredients": {},
      "expected_pull_request_state": "closed"
    },
    {
      "name": "implementation",
      "kind": "recipe",
      "pipeline": true,
      "peak_sessions": 8,
      "timeout_sec": 7200,
      "trigger_paths": [
        "src/autoskillit/recipes/*",
        "src/autoskillit/skills/*",
        "src/autoskillit/skills_extended/*",
        "src/autoskillit/server/*",
        "src/autoskillit/execution/*"
      ],
      "recipe": "implementation",
      "ingredients": {
        "source_dir": "/workspace/sandbox",
        "open_pr": "true",
        "auto_merge": "false",
        "arch_lenses": "false",
        "audit_impl": "true"
      },
      "expected_pull_request_state": "open",
      "issue_url_env": "E2E_IMPLEMENTATION_ISSUE_URL",
      "required_changed_paths": [
        "sandbox/",
        "tests/"
      ],
      "test_command": ["task", "test-check"]
    }
  ]
}
